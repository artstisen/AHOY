<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <LangVersion>14</LangVersion>
    <UseWindowsForms>true</UseWindowsForms>
    <!-- WPF is used for the spell checker (System.Windows.Controls.SpellCheck) -->
    <UseWPF>true</UseWPF>
    <RootNamespace>AhoyBrowser</RootNamespace>
    <AssemblyName>Ahoy</AssemblyName>
    <ApplicationIcon>Ahoy.ico</ApplicationIcon>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <Version>2.0.0</Version>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <Product>AHOY</Product>
    <Company>AHOY</Company>
    <AssemblyTitle>Ahoy</AssemblyTitle>
    <Copyright>Copyright © 2019-2026 LBS</Copyright>
    <ApplicationHighDpiMode>SystemAware</ApplicationHighDpiMode>
    <ForceDesignerDpiUnaware>true</ForceDesignerDpiUnaware>
    <!-- WFO1000: public runtime-only properties on forms; they are never designer-serialized -->
    <NoWarn>$(NoWarn);WFO1000</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="AhoyBrowser.Tests" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="TextFiles\*.txt" />
    <EmbeddedResource Include="ColorThemes\*.xml" />
  </ItemGroup>

</Project>
